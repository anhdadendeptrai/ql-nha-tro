# =============================================================================
# CẤU HÌNH SUPABASE (PRODUCTION VÀ TRIỂN KHAI CLOUDFLARE PAGES)
# Lấy từ Supabase Dashboard -> Project Settings -> API
# =============================================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# CẤU HÌNH TÀI KHOẢN THỬ NGHIỆM CHO NHÀ PHÁT TRIỂN
# CHỈ DÙNG TRÊN MÁY CÁ NHÂN, KHÔNG BẬT KHI DEPLOY (Mặc định: false)
# Khi VITE_DEV_MOCK_AUTH=true và đang chạy chế độ dev (npm run dev),
# cho phép đăng nhập bằng email & password bên dưới mà không cần kết nối Supabase.
# =============================================================================
VITE_DEV_MOCK_AUTH=false
VITE_DEV_EMAIL=chutro@test.local
VITE_DEV_PASSWORD=Tro@12345
